# Copy to .env and fill in. Never commit .env

APP_ENV=development
LOG_LEVEL=INFO

# Neon Postgres. Use the pooled connection string with the asyncpg driver.
# postgresql+asyncpg://user:password@host/dbname
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

# Signs the session cookie. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me

# Encrypts GitHub tokens at rest.
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=change-me

# GitHub OAuth app credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/auth/github/callback

FRONTEND_ORIGIN=http://localhost:5173

# Agent cost and safety caps
MAX_ITERATIONS=5
MAX_TOOL_CALLS=60
MAX_RUN_SECONDS=1800
MAX_RETRIEVED_CHUNKS=24

# Gemini. Model names get retired: gemini-2.5-flash started returning 404 for new API keys,
# which is why this is configuration and not a constructor default.
# List what your key can use:
#   curl -H "x-goog-api-key: $KEY" https://generativelanguage.googleapis.com/v1beta/models
GEMINI_API_KEY=
LLM_MODEL=gemini-3.6-flash

# Embeddings: gemini | fake. "fake" is deterministic and offline; use it when the free-tier
# embedding quota is exhausted, and do not claim retrieval quality from a run that used it.
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
# Client-side pacing for the embedding API. 0 disables. A rejected request still costs quota.
EMBEDDING_REQUESTS_PER_MINUTE=0

# Sandbox backend: github_actions | e2b | local_unsafe
# local_unsafe is process confinement, not isolation, and is refused in production.
SANDBOX_BACKEND=github_actions

# Where repositories are checked out, one directory per run. A checkout is the largest thing
# a run leaves on disk, and it is kept while the run awaits human review.
AGENT_WORKSPACE_ROOT=.agent-workspaces
